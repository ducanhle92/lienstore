{
  "name": "lienstore",
  "version": "1.71.0",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "release": "node scripts/release.mjs",
    "sync:prod": "node scripts/sync-from-prod.mjs",
    "docker:build": "docker build -t lienstore:local .",
    "docker:run": "docker run --rm -p 3000:3000 -v lienstore-data:/app/data --env-file .env.local lienstore:local",
    "db:export": "node scripts/db-export.mjs",
    "test:ghn": "npx -y tsx --conditions=react-server --test scripts/tests/ghn.test.ts",
    "test:vouchers": "npx -y tsx --conditions=react-server --test scripts/tests/voucher-programs.test.ts",
    "test:secrets": "npx -y tsx --conditions=react-server --test scripts/tests/secret-store.test.ts",
    "db:reset": "node -e \"const fs=require(\\\"fs\\\");for(const s of [\\\"\\\",\\\"-wal\\\",\\\"-shm\\\"])fs.rmSync(\\\"data/lienstore.db\\\"+s,{force:true});console.log(\\\"database removed; it will be re-created from data/seed.json on next start\\\")\"",
    "xlsx:export": "python scripts/xlsx/export_products_xlsx.py",
    "xlsx:import": "python scripts/xlsx/import_products_xlsx.py",
    "test:shipping": "npx -y tsx --conditions=react-server --test scripts/tests/carriers.test.ts",
    "test:vietqr": "npx -y tsx --conditions=react-server --test scripts/tests/vietqr.test.ts",
    "test:paycode": "npx -y tsx --conditions=react-server --test scripts/tests/pay-code.test.ts",
    "test:variants": "npx -y tsx --conditions=react-server --test scripts/tests/variants.test.ts",
    "test:sources": "npx -y tsx --conditions=react-server --test scripts/tests/purchase-sources.test.ts",
    "test:lots": "npx -y tsx --conditions=react-server --test scripts/tests/lots.test.ts",
    "test:pricing": "npx -y tsx --conditions=react-server --test scripts/tests/pricing.test.ts",
    "test:inventory": "npx -y tsx --conditions=react-server --test scripts/tests/inventory.test.ts",
    "test:description": "npx -y tsx --conditions=react-server --test scripts/tests/description-restructure.test.ts",
    "test:stocktake": "npx -y tsx --conditions=react-server --test scripts/tests/stocktake.test.ts",
    "test:warehouses": "npx -y tsx --conditions=react-server --test scripts/tests/warehouses.test.ts",
    "test:legs": "npx -y tsx --conditions=react-server --test scripts/tests/leg-status.test.ts",
    "test:fanpage": "npx -y tsx --conditions=react-server --test scripts/tests/fanpage.test.ts",
    "test:receipts": "npx -y tsx --conditions=react-server --test scripts/tests/receipts.test.ts",
    "test:prices": "npx -y tsx --conditions=react-server --test scripts/tests/price-display.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
