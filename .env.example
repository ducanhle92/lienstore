# Copy to .env.local and change the values before exposing the site.

# Admin account for /admin (defaults: admin / admin123 when unset — development only)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Optional: SQLite database file (defaults to ./data/lienstore.db; in Docker /app/data/lienstore.db)
# LIEN_DB_PATH=./data/lienstore.db
# Optional: seed catalogue imported when the database is empty (defaults to ./data/seed.json)
# LIEN_SEED_PATH=./data/seed.json
# Seed sync when a newer seed ships with a new build:
#   add (default) insert missing rows only | update: upsert rows present in seed (Excel/seed is the source of truth) | overwrite: replace catalogue | off
# LIEN_SEED_SYNC=add

# Optional: where admin uploads (product images, order receipts) are stored. Defaults to <db dir>/uploads.
# LIEN_UPLOAD_DIR=./data/uploads
# Optional: default low-stock threshold for the inventory page
# LIEN_MIN_STOCK=2

# GHN (Giao Hàng Nhanh) Production — live shipping quotes at checkout. Server-only: never NEXT_PUBLIC_*.
# Leave GHN_TOKEN empty to keep the estimate tables only. Pickup point = GHN district/ward codes of the warehouse.
GHN_BASE_URL=https://online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_PICKUP_DISTRICT_ID=1748
GHN_PICKUP_WARD_CODE=282201
GHN_TIMEOUT_MS=8000

# Public site URL used in robots.txt / sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Facebook Messenger customer chat (original site uses page 100282411711448). Leave empty to disable.
NEXT_PUBLIC_FB_PAGE_ID=
